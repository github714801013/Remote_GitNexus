# Copy this file to .env and fill values for your deployment environment.
# Do not commit real .env files.

REMOTE_HOST=deploy.example.com
REMOTE_USER=deploy
REMOTE_PATH=/srv/gitnexus-mcp
REMOTE_REPOS_PATH=/srv/gitnexus-repos
REMOTE_GITNEXUS_DATA_PATH=/home/deploy/.gitnexus

REGISTRY_HOST=registry.example.com
REGISTRY_PORT=1088
REGISTRY_NAMESPACE=common

GITNEXUS_GITEA_TOKEN=
GITEA_TOKEN=

GITNEXUS_EMBEDDING_URL=http://embedding.example.com:8080
GITNEXUS_INDEX_EMBEDDING_URL=http://embedding.example.com:8080
GITNEXUS_EMBEDDING_API_KEY=
GITNEXUS_EMBEDDING_MODEL=qwen3-embedding-4b
GITNEXUS_EMBEDDING_DIMS=2560
# 仅用于容器内回环地址的只读锁诊断接口；远程部署时按需显式设为 true。
GITNEXUS_LOCAL_DIAGNOSTICS_ENABLED=false

GITNEXUS_KEYWORD_SUMMARY_URL=http://keyword-summary.example.com:8080
GITNEXUS_KEYWORD_SUMMARY_MODEL=qwen3.6-35b-carnice
GITNEXUS_KEYWORD_SUMMARY_API_KEY=
GITNEXUS_KEYWORD_SUMMARY_ENABLED=true
GITNEXUS_KEYWORD_SUMMARY_LANGUAGE=中文
GITNEXUS_KEYWORD_SUMMARY_CONCURRENCY=2
GITNEXUS_KEYWORD_SUMMARY_MAX_CHARS=6000
GITNEXUS_KEYWORD_SUMMARY_TIMEOUT_MS=60000
GITNEXUS_KEYWORD_SUMMARY_MAX_TOKENS=512
GITNEXUS_KEYWORD_SUMMARY_FAILURE_COOLDOWN_MS=300000
KEYWORD_SUMMARY_MODEL_DIR=/srv/gitnexus-keyword-summary/models
KEYWORD_SUMMARY_MODEL_FILE=Qwen2.5-Coder-14B-Instruct-Q4_K_M.gguf

# Wiki LLM defaults to the same OpenAI-compatible endpoint as keyword summary.
GITNEXUS_WIKI_LLM_PROVIDER=custom
GITNEXUS_WIKI_LLM_URL=http://keyword-summary.example.com:8080
GITNEXUS_WIKI_LLM_MODEL=qwen3.6-35b-carnice
GITNEXUS_WIKI_LLM_API_KEY=

GITNEXUS_NEO4J_USER=neo4j
GITNEXUS_NEO4J_PASSWORD=

HOST_ZOEKT_PORT=6070
HOST_NEO4J_HTTP_PORT=7474
HOST_NEO4J_BOLT_PORT=7687
HOST_KEYWORD_SUMMARY_PORT=955
HOST_GITNEXUS_HTTP_PORT=1347
HOST_GITNEXUS_MCP_PORT=1350

REPOS_BASE_DIR=/srv/gitnexus-repos
REPO_CLONE_SPECS=https://git.example.com/group/project-a.git|group/project-a;https://git.example.com/group/project-b.git|group/project-b
